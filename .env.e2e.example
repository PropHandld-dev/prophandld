# Copy this file to .env.e2e.local (already gitignored) and fill in the real
# values. These are the existing test accounts used throughout manual QA —
# do not use real landlord/renter/contractor accounts here.

E2E_LANDLORD_EMAIL=
E2E_LANDLORD_PASSWORD=

E2E_RENTER_EMAIL=
E2E_RENTER_PASSWORD=

E2E_CONTRACTOR_EMAIL=
E2E_CONTRACTOR_PASSWORD=

